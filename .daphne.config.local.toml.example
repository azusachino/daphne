[app]
telegram_api_url = "http://telegram-bot-api:8081"
video_upload_limit_mb = 256
# Heavy-download concurrency guard:
# max_concurrent_downloads = 3
# max_user_concurrent_downloads = 1

[rbac]
public_commands = ["help"]
convert_link_limit = 60
extract_audio_limit = 10
download_video_limit = 5
preview_video_limit = 10
fetch_metadata_limit = 30

[rbac.roles.admin]
permissions = ["*"]

[rbac.roles.standard_group]
permissions = ["convert_link", "extract_audio", "preview_video", "download_video", "fetch_metadata", "download_gallery"]

[rbac.roles.inline_user]
permissions = ["inline_convert"]

[rbac.users]
# Replace with your Telegram numeric user ID.
# 111111111 = "admin"

[rbac.chats]
# Replace with your private test chat/group/channel ID.
# -1001111111111 = "standard_group"
